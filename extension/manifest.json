{
  "manifest_version": 3,
  "name": "Text Tunnel 흔적 지우기",
  "version": "1.0.0",
  "description": "Text Tunnel을 쓴 방문 기록과 캐시를 지웁니다. 다른 사이트 기록은 건드리지 않습니다.",
  "permissions": ["history", "browsingData", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Text Tunnel 흔적 지우기" },
  "content_scripts": [
    {
      "matches": ["https://text-tunnel.onrender.com/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon.png" }
}
